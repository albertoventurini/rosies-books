# Copy values into an untracked local environment file or deployment secret manager.
# These placeholders are deliberately not usable credentials.
GOOGLE_OIDC_CLIENT_ID=replace-with-google-client-id
GOOGLE_OIDC_CLIENT_SECRET=replace-with-secret-manager-value
GOOGLE_OIDC_STATE_SECRET=replace-with-a-random-32-byte-base64url-secret
GOOGLE_OIDC_ALLOWED_EMAILS=allowed-reader@example.com

# Used only with: ./mvnw quarkus:dev -Dquarkus.profile=local-oidc
GOOGLE_OIDC_LOCAL_CLIENT_ID=replace-with-local-google-client-id
GOOGLE_OIDC_LOCAL_CLIENT_SECRET=replace-with-local-secret-manager-value
GOOGLE_OIDC_LOCAL_STATE_SECRET=replace-with-a-different-random-32-byte-base64url-secret
GOOGLE_OIDC_LOCAL_ALLOWED_EMAILS=local-tester@example.com
