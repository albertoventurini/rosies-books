# Copy this file to an untracked environment file and replace every angle-bracket value.
# Do not put credentials, allowlisted email addresses, or this copied file in version control.

# PostgreSQL database created by the production Compose service.
ROSIES_BOOKS_DATABASE_NAME=<database-name>
# Initial PostgreSQL superuser password; used only to bootstrap the database and role.
ROSIES_BOOKS_DATABASE_BOOTSTRAP_PASSWORD=<long-random-bootstrap-password>
# Password for the fixed least-privileged rosies_books_app role.
ROSIES_BOOKS_DATABASE_PASSWORD=<long-random-application-password>

# Google OAuth Web client configured with the production HTTPS callback URL.
ROSIES_BOOKS_GOOGLE_OIDC_CLIENT_ID=<google-oauth-client-id>
ROSIES_BOOKS_GOOGLE_OIDC_CLIENT_SECRET=<google-oauth-client-secret>
# Random application state-encryption secret; use an independently generated value.
ROSIES_BOOKS_GOOGLE_OIDC_STATE_SECRET=<random-oidc-state-secret>
# Comma-separated, verified Google email addresses permitted to use this private service.
ROSIES_BOOKS_GOOGLE_OIDC_ALLOWED_EMAILS=<allowed-reader-email>

# Independent secret used to sign short-lived provider-review forms.
ROSIES_BOOKS_REVIEW_TOKEN_SECRET=<long-random-review-token-secret>
# Contact address sent to Open Library in the service User-Agent.
ROSIES_BOOKS_OPEN_LIBRARY_OPERATOR_CONTACT=<operator-contact-email>

# Optional host HTTP port; a reverse proxy/TLS terminator belongs in front of this service.
ROSIES_BOOKS_HTTP_PORT=8080
# Optional prebuilt application image reference; defaults to rosies-books:latest.
ROSIES_BOOKS_IMAGE=rosies-books:latest
